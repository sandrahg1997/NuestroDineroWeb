NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=TU_CLAVE_PUBLICABLE

# Solo se usa en el servidor (para eliminar cuentas de usuario y para el cron de
# recurrentes). Cógela de Supabase > Project Settings > API > service_role.
# NUNCA la lleves al navegador ni la pongas con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=TU_CLAVE_SERVICE_ROLE

# Protege el endpoint del cron (/api/cron/recurring). Pon una cadena larga y
# aleatoria. En Vercel, al definir esta variable, el cron manda automáticamente
# la cabecera Authorization con este valor.
CRON_SECRET=CADENA_LARGA_ALEATORIA
